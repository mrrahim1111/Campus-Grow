# Public Supabase client configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key

# Server-only Supabase admin key. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Cloudflare API token with permission to deploy Workers.
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# Razorpay Dashboard API credentials. Use matching test-mode or live-mode credentials.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Recurring Plans created in the same Razorpay account/mode as the API credentials.
RAZORPAY_PLAN_MONTHLY_ID=plan_your_monthly_plan_id
RAZORPAY_PLAN_ANNUAL_ID=plan_your_annual_plan_id

# Webhook secret configured for /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
